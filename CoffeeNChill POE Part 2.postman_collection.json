          "raw": "{\r\n\"OrderId\": \"ORD-2026-004\",\r\n\"CustomerName\": \"Cayd Smith\",\r\n\"SelectedItemSKUs\": [\r\n\"COF-003\",\r\n\"PAS-104\"\r\n],\r\n\r\n\"TotalPrice\": 75.00\r\n}",
