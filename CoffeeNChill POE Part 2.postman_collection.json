      "name": "Valid Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 202 Accepted\", function () {\n    pm.response.to.have.status(202);\n});\n\npm.test(\"Response contains Queued status\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.status).to.eql(\"Queued\");\n});\n\npm.test(\"Correct OrderId is returned\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.orderId).to.eql(\"ORD-2026-004\");\n});\n\npm.test(\"Order timestamp is generated\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.orderTimestamp).to.not.be.empty;\n});"
            ]
          }
        }
      ],
