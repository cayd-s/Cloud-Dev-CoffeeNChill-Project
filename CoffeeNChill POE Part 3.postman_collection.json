    {
      "name": "Admin staff invitations",
      "item": [
        {
          "name": "Create Staff Invitation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response status is expected for this request', function () {",
                  "    pm.expect([201, 401, 403, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response time is under 10 seconds', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const d = pm.response.json(); const inv = d.invitation || d;",
                  "    const id = inv.invitationId || inv.InvitationId || inv.id;",
                  "    const token = d.developmentInvitationToken;",
                  "    if (id) pm.collectionVariables.set('invitationId', id);",
                  "    if (token) pm.collectionVariables.set('invitationToken', token);",
                  "    pm.test('Invitation ID returned', function () { pm.expect(id, 'invitation ID').to.be.a('string').and.not.empty; });",
                  "    pm.test('Development invitation token returned when running in Development', function () {",
                  "        if (pm.environment.get('expectDevelopmentInvitationToken') === 'true') pm.expect(token, 'developmentInvitationToken').to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminJwt}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"fullName\": \"Postman Test Staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/staff/invitations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "staff",
                "invitations"
              ]
            },
            "description": "Requires Admin JWT. In Development, response should include developmentInvitationToken; copy it and invitation.invitationId (or invitationId) into variables."
          },
          "response": []
        },
